# The gateway never starts or stops the backend.
AI_DETECTIVE_ALLOW_REMOTE_SOURCE=false
AI_DETECTIVE_API_HOST=127.0.0.1
AI_DETECTIVE_API_PORT=8000
AI_DETECTIVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI mode for the dashboard.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
